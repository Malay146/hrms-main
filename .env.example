# Standard local PostgreSQL (default user + default database)
# This machine's Postgres 18 listens on 5433 (17 used 5432 and is stopped).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/postgres"

# Better Auth (httpOnly cookie sessions)
BETTER_AUTH_SECRET="replace-with-a-32-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Optional public origin for the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# First-time local setup (PowerShell):
#   1. Put your postgres user password into DATABASE_URL in .env and .env.local
#   2. npx prisma migrate deploy
#   3. npm run db:seed
#   4. npm run dev
#
# Seed logins (password for every account): Password1
#   Admin:    admin@acme.com
#   Employee: john.cena@organization.com
