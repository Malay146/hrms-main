# Standard local PostgreSQL (not Docker) on the default port 5432
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/PeoplePay360"

# Better Auth (httpOnly cookie sessions)
BETTER_AUTH_SECRET="replace-with-a-32-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP — used when an admin creates a user (credentials email), sends payslips,
# or a user requests a password reset.
# Put real values in .env and .env.local. Never commit SMTP_PASS.
# SMTP_PASS must be a Google App Password, NOT your Gmail account password.
# 1. Turn on 2-Step Verification for the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password (spaces are optional; the app strips them)
# 4. Restart `npm run dev` after changing these values
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="HRMS <your-gmail@gmail.com>"
# Recipient domains that never get mail (seeded demo accounts use @company.com,
# a real third-party domain). Default: company.com. Set "" to allow all.
MAIL_SKIP_DOMAINS="company.com"

# Optional — protects /api/cron/payslips and /api/cron/jobs.
# Generate: openssl rand -hex 32   Trigger: npm run cron:payslips
CRON_SECRET=""

# Optional — AI insight cards and copilot (metrics work without any AI key).
# Option A, free: Google Gemini via its OpenAI-compatible endpoint.
#   Key: https://aistudio.google.com/apikey  (free tier: Google may use prompts to improve products)
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_MODEL="gemini-2.5-flash"
AI_API_KEY=""
# Option B: OpenAI (used whenever AI_API_KEY above is empty).
OPENAI_API_KEY=""

# Optional — shared rate-limit store (login, signup, password reset, copilot, /api/v1).
# Without this, limits are in-memory per Node process. Do not use Redis for sessions or jobs.
REDIS_URL="" # e.g. redis://localhost:6379 (brew install redis && brew services start redis)

# First-time local setup:
#   1. Install PostgreSQL 16+ and start it on port 5432
#   2. Create DB PeoplePay360 + role matching DATABASE_URL
#   3. Copy this file to .env and fill in real values
#   4. npx prisma migrate deploy
#   5. npm run db:seed
#   6. npm run dev
#
# Seed login:
#   Admin: admin@company.com / admin@company@1234
