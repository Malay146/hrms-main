# Standard local PostgreSQL (Homebrew — not Docker)
# Example: postgresql@16 listening on port 5433
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/PeoplePay360"

# Better Auth (httpOnly cookie sessions)
BETTER_AUTH_SECRET="replace-with-a-32-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP — used when an admin creates a user (credentials email), sends payslips,
# or a user requests a password reset.
# Put real values in .env and .env.local. Never commit SMTP_PASS.
# SMTP_PASS must be a Google App Password, NOT your Gmail account password.
# 1. Turn on 2-Step Verification for the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password (spaces are optional; the app strips them)
# 4. Restart `npm run dev` after changing these values
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="HRMS <your-gmail@gmail.com>"

# Optional — month-end payslip cron. GET/POST /api/cron/payslips with
# Authorization: Bearer <CRON_SECRET>  (or ?secret=)
CRON_SECRET=""

# Optional — AI Analytics narratives and copilot phrasing (metrics work without this)
OPENAI_API_KEY=""

# Optional — shared rate-limit store (login, signup, password reset, copilot, /api/v1).
# Without this, limits are in-memory per Node process. Do not use Redis for sessions or jobs.
REDIS_URL=""

# First-time local setup:
#   1. brew install postgresql@16 && start it on port 5433
#   2. Create DB PeoplePay360 + role matching DATABASE_URL
#   3. Copy this file to .env and fill in real values
#   4. npx prisma migrate deploy
#   5. npm run db:seed
#   6. npm run dev
#
# Seed login:
#   Admin: admin@oddo.com / admin@oddo@1234
