# Standard local PostgreSQL (Homebrew — not Docker)
# Example: postgresql@16 listening on port 5433
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/PeoplePay360"

# Better Auth (httpOnly cookie sessions)
BETTER_AUTH_SECRET="replace-with-a-32-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP — used when an admin creates a user (credentials email)
# Put real values in .env only. Never commit SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="HRMS <your-gmail@gmail.com>"

# First-time local setup:
#   1. brew install postgresql@16 && start it on port 5433
#   2. Create DB PeoplePay360 + role matching DATABASE_URL
#   3. Copy this file to .env and fill in real values
#   4. npx prisma migrate deploy
#   5. npm run db:seed
#   6. npm run dev
#
# Seed login:
#   Admin: admin@oddo.com / admin@oddo@1234
