# Standard local PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/PeoplePay360"

# Better Auth (httpOnly cookie sessions)
BETTER_AUTH_SECRET="replace-with-a-32-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP — used when an admin creates a user (credentials email)
# Put real values in .env / .env.local only. Never commit SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="HRMS <your-gmail@gmail.com>"

# First-time local setup (PowerShell):
#   1. Put your postgres user password into DATABASE_URL in .env and .env.local
#   2. Put a Gmail app password into SMTP_PASS (never commit it)
#   3. npx prisma migrate deploy
#   4. npm run db:seed
#   5. npm run dev
#
# Seed login (the only account until admin creates more):
#   Admin: admin@oddo.com / admin@oddo@1234
