generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  hr_manager
  hr_payroll_user
  hr_payroll_manager
  employee
}

enum EmployeeStatus {
  active
  inactive
  on_leave
}

enum AttendanceStatus {
  present
  absent
  half_day
  leave
}

enum LeaveType {
  paid
  sick
  unpaid
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum EmployeeType {
  full_time
  intern
  contractor
}

enum SalaryCategory {
  basic
  allowance
  gross
  deduction
  net
  contribution
}

enum RuleComputation {
  fixed
  percent_of_wage
  percent_of_basic
  percent_of_gross
  percent_of_category
  formula
}

enum PayrunStatus {
  draft
  computed
  validated
  paid
}

enum PayslipStatus {
  draft
  computed
  validated
  paid
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String    @default("employee")
  mustChangePassword Boolean @default(false)
  sessions      Session[]
  accounts      Account[]
  profile       EmployeeProfile?
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  payrolls      Payroll[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String    @default("local:credential")
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  email            String
  slug             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  profiles         EmployeeProfile[]
  salaryStructures SalaryStructure[]
  payruns          Payrun[]

  @@map("organization")
}

model EmployeeProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId       String         @unique
  fullName         String
  role             Role
  department       String
  jobTitle         String
  phone            String?
  status           EmployeeStatus @default(active)
  paidLeaveBalance Int            @default(20)
  employeeType     EmployeeType   @default(full_time)
  bankAccount      String?
  wage             Decimal?       @db.Decimal(12, 2)
  payslips         Payslip[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
  @@map("employee_profile")
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@map("attendance")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  remarks      String
  status       LeaveStatus @default(pending)
  adminComment String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, status])
  @@index([startDate, endDate])
  @@map("leave_request")
}

model Payroll {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        String
  basic        Decimal  @db.Decimal(12, 2)
  hraPct       Decimal  @map("hra_pct") @db.Decimal(5, 2)
  allowancePct Decimal  @map("allowance_pct") @db.Decimal(5, 2)
  deductions   Decimal  @db.Decimal(12, 2)
  netSalary    Decimal  @default(dbgenerated("basic + (basic * hra_pct / 100.0) + (basic * allowance_pct / 100.0) - deductions")) @map("net_salary") @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, month])
  @@map("payroll")
}

model SalaryStructure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean      @default(true)
  rules          SalaryRule[]
  payruns        Payrun[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("salary_structure")
}

model SalaryRule {
  id              String          @id @default(cuid())
  structureId     String
  structure       SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name            String
  code            String
  category        SalaryCategory
  sequence        Int
  computation     RuleComputation
  amount          Decimal?        @db.Decimal(12, 2)
  percentage      Decimal?        @db.Decimal(8, 4)
  percentBaseCode String?
  formula         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([structureId, sequence])
  @@map("salary_rule")
}

model Payrun {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  structureId    String
  structure      SalaryStructure @relation(fields: [structureId], references: [id])
  periodStart    DateTime        @db.Date
  periodEnd      DateTime        @db.Date
  employeeType   EmployeeType?
  status         PayrunStatus    @default(draft)
  payslips       Payslip[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, periodStart])
  @@map("payrun")
}

model Payslip {
  id          String         @id @default(cuid())
  payrunId    String
  payrun      Payrun         @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractId  String?
  workedDays  Decimal        @db.Decimal(6, 2)
  status      PayslipStatus  @default(draft)
  warning     String?
  wage        Decimal        @default(0) @db.Decimal(12, 2)
  gross       Decimal        @default(0) @db.Decimal(12, 2)
  net         Decimal        @default(0) @db.Decimal(12, 2)
  lines       PayslipLine[]
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([payrunId, employeeId])
  @@index([employeeId])
  @@map("payslip")
}

model PayslipLine {
  id        String         @id @default(cuid())
  payslipId String
  payslip   Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  ruleId    String?
  name      String
  code      String
  category  SalaryCategory
  amount    Decimal        @db.Decimal(12, 2)

  @@index([payslipId])
  @@map("payslip_line")
}
