generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  hr_manager
  hr_payroll_user
  hr_payroll_manager
  employee
}

enum EmployeeStatus {
  active
  inactive
  on_leave
}

enum EmployeeType {
  full_time
  intern
  contractor
}

enum AttendanceStatus {
  present
  absent
  half_day
  leave
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum ContractStatus {
  running
  expired
}

enum CalendarType {
  fixed
  variable
}

enum TimeOffUnit {
  days
  hours
}

enum TimeOffApprover {
  manager
  officer
}

enum AllocationStatus {
  draft
  approved
  refused
}

enum JobOpeningStatus {
  active
  closed
}

enum CandidateStage {
  applied
  screening
  interview
  technical
  offer
  hired
  rejected
}

enum SalaryCategory {
  basic
  allowance
  gross
  deduction
  net
  contribution
}

enum RuleComputation {
  fixed
  percent_of_wage
  percent_of_basic
  percent_of_gross
  percent_of_category
  formula
}

enum PayrunStatus {
  draft
  computed
  validated
  paid
}

enum PayslipStatus {
  draft
  computed
  validated
  paid
}

enum CycleStatus {
  open
  closed
}

enum ReviewStatus {
  draft
  submitted
  acknowledged
}

enum GoalStatus {
  not_started
  in_progress
  completed
}

model User {
  id                 String           @id
  name               String
  email              String
  emailVerified      Boolean
  image              String?
  createdAt          DateTime
  updatedAt          DateTime
  role               String           @default("employee")
  mustChangePassword Boolean          @default(false)
  sessions           Session[]
  accounts           Account[]
  profile            EmployeeProfile?
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  payrolls           Payroll[]
  notifications      Notification[]
  notificationPreference NotificationPreference?
  copilotConversations CopilotConversation[]
  copilotMessages    CopilotMessage[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String    @default("local:credential")
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                    String              @id @default(cuid())
  name                  String
  email                 String
  slug                  String              @unique
  inactiveEmployeeCount Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  profiles              EmployeeProfile[]
  departments           Department[]
  schedules             WorkingSchedule[]
  timeOffTypes          TimeOffType[]
  salaryStructures      SalaryStructure[]
  payruns               Payrun[]
  aiInsights            AiInsight[]
  jobOpenings           JobOpening[]
  candidates            Candidate[]
  performanceCycles     PerformanceCycle[]

  @@map("organization")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

model NotificationPreference {
  userId           String  @id
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailLeave       Boolean @default(true)
  emailRecruitment Boolean @default(true)
  emailPerformance Boolean @default(false)
  emailPayroll     Boolean @default(true)
  inApp            Boolean @default(true)
  sounds           Boolean @default(false)

  @@map("notification_preference")
}

model CopilotConversation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  pendingAction  Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       CopilotMessage[]

  @@index([userId, updatedAt])
  @@map("copilot_conversation")
}

model CopilotMessage {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  body           String
  source         String?
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@map("copilot_message")
}

model Department {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  profiles       EmployeeProfile[]
  contracts      Contract[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("department")
}

model WorkingSchedule {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  calendarType   CalendarType          @default(fixed)
  timezone       String                @default("Asia/Kolkata")
  active         Boolean               @default(true)
  hoursPerWeek   Decimal               @db.Decimal(6, 2)
  daysPerWeek    Int
  lines          WorkingScheduleLine[]
  profiles       EmployeeProfile[]
  contracts      Contract[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId])
  @@map("working_schedule")
}

model WorkingScheduleLine {
  id         String          @id @default(cuid())
  scheduleId String
  weekday    Int
  startMin   Int
  endMin     Int
  breakMin   Int             @default(60)
  hours      Decimal         @db.Decimal(4, 2)
  schedule   WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("working_schedule_line")
}

model EmployeeProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId       String              @unique
  fullName         String
  role             Role
  departmentId     String
  department       Department          @relation(fields: [departmentId], references: [id])
  managerId        String?
  manager          EmployeeProfile?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports          EmployeeProfile[]   @relation("EmployeeManager")
  scheduleId       String?
  schedule         WorkingSchedule?    @relation(fields: [scheduleId], references: [id])
  employeeType     EmployeeType        @default(full_time)
  workLocation     String?
  companyName      String?
  bankAccount      String?
  wage             Decimal?            @db.Decimal(12, 2)
  personalEmail    String?
  address          String?
  joinDate         DateTime?           @db.Date
  jobTitle         String
  phone            String?
  status           EmployeeStatus      @default(active)
  paidLeaveBalance Int                 @default(20)
  contracts        Contract[]
  allocations      TimeOffAllocation[]
  payslips         Payslip[]
  reviews          PerformanceReview[] @relation("ReviewEmployee")
  reviewsGiven     PerformanceReview[] @relation("ReviewReviewer")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, employeeId])
  @@index([departmentId])
  @@index([scheduleId])
  @@index([managerId])
  @@map("employee_profile")
}

model Contract {
  id                String           @id @default(cuid())
  code              String           @unique
  employeeId        String
  employee          EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  scheduleId        String?
  schedule          WorkingSchedule? @relation(fields: [scheduleId], references: [id])
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  jobTitle          String
  wage              Decimal          @db.Decimal(12, 2)
  startDate         DateTime         @db.Date
  endDate           DateTime?        @db.Date
  status            ContractStatus
  notes             String?
  payslips          Payslip[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([employeeId])
  @@index([departmentId])
  @@index([scheduleId])
  @@index([salaryStructureId])
  @@map("contract")
}

model TimeOffType {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  unit               TimeOffUnit         @default(days)
  requiresAllocation Boolean             @default(true)
  approver           TimeOffApprover     @default(manager)
  color              String              @default("zinc")
  payrollNote        String?
  allocations        TimeOffAllocation[]
  leaveRequests      LeaveRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("time_off_type")
}

model TimeOffAllocation {
  id            String        @id @default(cuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId        String
  type          TimeOffType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  allocated     Decimal       @db.Decimal(8, 2)
  taken         Decimal       @default(0) @db.Decimal(8, 2)
  validityYear  Int
  status        AllocationStatus @default(draft)
  description   String?
  leaveRequests LeaveRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId])
  @@index([typeId])
  @@map("time_off_allocation")
}

model LeaveRequest {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeId       String
  type         TimeOffType        @relation(fields: [typeId], references: [id])
  allocationId String?
  allocation   TimeOffAllocation? @relation(fields: [allocationId], references: [id])
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  duration     Decimal            @db.Decimal(8, 2)
  remarks      String
  status       LeaveStatus        @default(pending)
  adminComment String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, status])
  @@index([status, startDate, endDate])
  @@index([startDate, endDate])
  @@index([typeId])
  @@index([allocationId])
  @@map("leave_request")
}

model Attendance {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus
  workedHours   Decimal?         @db.Decimal(6, 2)
  overtimeHours Decimal?         @db.Decimal(6, 2)
  notes         String?
  manualEdit    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
  @@map("attendance")
}

model SalaryStructure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean      @default(true)
  rules          SalaryRule[]
  contracts      Contract[]
  payruns        Payrun[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("salary_structure")
}

model SalaryRule {
  id              String          @id @default(cuid())
  structureId     String
  structure       SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name            String
  code            String
  category        SalaryCategory
  sequence        Int
  computation     RuleComputation
  amount          Decimal?        @db.Decimal(12, 2)
  percentage      Decimal?        @db.Decimal(8, 4)
  percentBaseCode String?
  formula         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([structureId])
  @@map("salary_rule")
}

model Payrun {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  structureId    String
  structure      SalaryStructure @relation(fields: [structureId], references: [id])
  periodStart    DateTime       @db.Date
  periodEnd      DateTime       @db.Date
  employeeType   EmployeeType?
  status         PayrunStatus   @default(draft)
  payslips       Payslip[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([structureId])
  @@map("payrun")
}

model Payslip {
  id         String          @id @default(cuid())
  payrunId   String
  payrun     Payrun          @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employeeId String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  workedDays Decimal         @db.Decimal(6, 2)
  status     PayslipStatus   @default(draft)
  warning    String?
  wage       Decimal         @default(0) @db.Decimal(12, 2)
  gross      Decimal         @default(0) @db.Decimal(12, 2)
  net        Decimal         @default(0) @db.Decimal(12, 2)
  lines      PayslipLine[]
  sentAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([payrunId, employeeId])
  @@index([employeeId])
  @@index([contractId])
  @@map("payslip")
}

model PayslipLine {
  id        String         @id @default(cuid())
  payslipId String
  payslip   Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  ruleId    String?
  name      String
  code      String
  category  SalaryCategory
  amount    Decimal        @db.Decimal(12, 2)

  @@index([payslipId])
  @@map("payslip_line")
}

model PerformanceCycle {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  periodStart    DateTime             @db.Date
  periodEnd      DateTime             @db.Date
  status         CycleStatus          @default(open)
  reviews        PerformanceReview[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
  @@map("performance_cycle")
}

model PerformanceReview {
  id                String             @id @default(cuid())
  cycleId           String
  cycle             PerformanceCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          EmployeeProfile    @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId        String?
  reviewer          EmployeeProfile?   @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  status            ReviewStatus       @default(draft)
  overallRating     Decimal?           @db.Decimal(3, 1)
  summary           String             @default("")
  employeeComments  String             @default("")
  submittedAt       DateTime?
  acknowledgedAt    DateTime?
  goals             PerformanceGoal[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_review")
}

model PerformanceGoal {
  id          String             @id @default(cuid())
  reviewId    String
  review      PerformanceReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  title       String
  description String             @default("")
  progress    Int                @default(0)
  status      GoalStatus         @default(not_started)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([reviewId])
  @@map("performance_goal")
}

model AiInsight {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  severity       String
  title          String
  body           String
  action         String
  href           String?
  payload        Json?
  generatedAt    DateTime     @default(now())
  expiresAt      DateTime

  @@index([organizationId, generatedAt])
  @@map("ai_insight")
}

model JobOpening {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  title          String
  department     String
  description    String           @default("")
  deadline       DateTime         @db.Date
  status         JobOpeningStatus @default(active)
  candidates     Candidate[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("job_opening")
}

model Candidate {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobOpeningId     String?
  jobOpening       JobOpening?    @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  code             String
  name             String
  email            String?
  position         String
  experienceYears  Int            @default(0)
  stage            CandidateStage @default(applied)
  rating           Decimal        @default(0) @db.Decimal(3, 1)
  source           String?
  appliedAt        DateTime       @default(now()) @db.Date
  interviewAt      DateTime?
  interviewType    String?
  interviewer      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, stage])
  @@index([jobOpeningId])
  @@map("candidate")
}

/// Legacy payroll rows — keep until Krishil retires in payrun Phase 3.
model Payroll {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        String
  basic        Decimal  @db.Decimal(12, 2)
  hraPct       Decimal  @map("hra_pct") @db.Decimal(5, 2)
  allowancePct Decimal  @map("allowance_pct") @db.Decimal(5, 2)
  deductions   Decimal  @db.Decimal(12, 2)
  netSalary    Decimal  @default(dbgenerated("basic + (basic * hra_pct / 100.0) + (basic * allowance_pct / 100.0) - deductions")) @map("net_salary") @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, month])
  @@map("payroll")
}
